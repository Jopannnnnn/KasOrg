        "disableCookieJar": true
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('HTTP 401', () => pm.response.to.have.status(401));"
            ]
          }
        }
      ]
    },
    {
      "name": "03 Ambil form login dan CSRF",
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Accept",
            "value": "text/html"
          }
        ],
        "url": "{{base_url}}/login"
      },
      "protocolProfileBehavior": {
        "followRedirects": false,
        "disableCookieJar": false
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Form login HTTP 200', () => pm.response.to.have.status(200));",
              "const html = pm.response.text();",
              "const $ = require('cheerio').load(html);",
              "const token = $('form').filter((i, form) => /\\/login\\/?$/.test($(form).attr('action') || ''))",
              "    .find('input[name=\"_token\"]').first().attr('value');",
              "pm.environment.unset('csrf_token');",
              "pm.environment.unset('api_saldo_akhir');",
              "pm.test('Token CSRF asli tersedia pada form login', () => {",
              "    pm.expect(token, 'Input _token tidak ditemukan pada form POST login. Periksa cookie sesi dan respons GET /login.').to.be.a('string').and.not.empty;",
              "    pm.environment.set('csrf_token', token);",
              "});"
            ]
          }
        }
      ]
    },
    {
      "name": "04 Login Laravel asli",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Accept",
            "value": "text/html"
          }
        ],
        "url": "{{base_url}}/login",
        "body": {
          "mode": "urlencoded",
          "urlencoded": [
            {
              "key": "_token",
              "value": "{{csrf_token}}",
              "type": "text"
            },
            {
              "key": "email",
              "value": "{{email}}",
              "type": "text"
            },
            {
              "key": "password",
              "value": "{{password}}",
              "type": "text"
            }
          ]
        }
      },
      "protocolProfileBehavior": {
        "followRedirects": false,
        "disableCookieJar": false
      },
      "event": [
        {
          "listen": "prerequest",
          "script": {
            "type": "text/javascript",
            "exec": [
              "if (!pm.environment.get('email') || !pm.environment.get('password')) {",
              "    throw new Error('Isi email dan password akun Admin lokal pada environment privat sebelum Run.');",
              "}",
              "if (!pm.environment.get('csrf_token')) {",
              "    throw new Error('Token CSRF login belum tersedia. Jalankan Test 03 terlebih dahulu dengan cookie jar aktif.');",
              "}"
            ]
          }
        },
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Login berhasil HTTP 302', () => pm.response.to.have.status(302));",
              "const location = pm.response.headers.get('Location') || '';",
              "pm.test('Login mengarah ke Dashboard Admin', () => pm.expect(location).to.eql(pm.environment.get('base_url') + '/admin/dashboard'));"
            ]
          }
        }
      ]
    },
    {
      "name": "05 Kategori nyata — 200",
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Accept",
            "value": "application/json"
          }
        ],
        "url": "{{base_url}}/api/kategori-transaksi"
      },
      "protocolProfileBehavior": {
        "followRedirects": false,
        "disableCookieJar": false
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('HTTP 200', () => pm.response.to.have.status(200));",
              "pm.test('Kategori berisi field yang diperlukan', () => pm.response.json().data.forEach(row => {",
              "    pm.expect(Object.keys(row)).to.eql(['id','nama','jenis']);",
              "    pm.expect(row.id).to.be.a('number');",
              "    pm.expect(row.nama).to.be.a('string');",
              "    pm.expect(['pemasukan','pengeluaran']).to.include(row.jenis);",
              "}));"
            ]
          }
