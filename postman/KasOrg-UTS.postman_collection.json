              "pm.test('Sesi sudah berakhir HTTP 401 tanpa data privat', () => {",
              "    pm.response.to.have.status(401);",
              "    const body = pm.response.json();",
              "    pm.expect(body.success).to.eql(false);",
              "    pm.expect(body.message).to.eql('Silakan login terlebih dahulu.');",
              "    pm.expect(body.data).to.eql(null);",
