    },
    {
      "name": "07 Ringkasan kas dan rumus presisi — 200",
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Accept",
            "value": "application/json"
          }
        ],
        "url": "{{base_url}}/api/transparansi/ringkasan?periode_id={{periode_id}}"
      },
      "protocolProfileBehavior": {
        "followRedirects": false,
        "disableCookieJar": false
      },
      "event": [
        {
          "listen": "prerequest",
          "script": {
            "type": "text/javascript",
            "exec": [
              "// Jangan memakai saldo hasil run sebelumnya bila respons berikutnya gagal.",
              "pm.environment.unset('api_saldo_akhir');"
            ]
          }
        },
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('HTTP 200', () => pm.response.to.have.status(200));",
              "const d = pm.response.json().data;",
              "function cents(value) {",
              "    pm.expect(value).to.match(/^-?\\d+\\.\\d{2}$/);",
              "    const negative = value.startsWith('-');",
              "    const digits = value.replace('-', '').replace('.', '');",
              "    return (negative ? -1n : 1n) * BigInt(digits);",
              "}",
              "pm.test('Saldo akhir = awal + masuk - keluar', () => pm.expect(cents(d.saldo_awal) + cents(d.pemasukan) - cents(d.pengeluaran) === cents(d.saldo_akhir)).to.eql(true));",
              "pm.test('Grafik sesuai total', () => {",
              "    const total = key => d.grafik_bulanan.reduce((sum, row) => sum + cents(row[key]), 0n);",
              "    pm.expect(total('pemasukan') === cents(d.pemasukan)).to.eql(true);",
              "    pm.expect(total('pengeluaran') === cents(d.pengeluaran)).to.eql(true);",
              "});",
              "if (pm.response.code === 200 && typeof d.saldo_akhir === 'string' && /^-?\\d+\\.\\d{2}$/.test(d.saldo_akhir)) {",
              "    pm.environment.set('api_saldo_akhir', String(d.saldo_akhir));",
              "}"
            ]
          }
        }
      ]
    },
    {
      "name": "08 Dashboard konsisten dengan API",
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Accept",
            "value": "text/html"
          }
        ],
        "url": "{{base_url}}/admin/dashboard?periode_id={{periode_id}}"
      },
      "protocolProfileBehavior": {
        "followRedirects": false,
        "disableCookieJar": false
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Dashboard HTTP 200', () => pm.response.to.have.status(200));",
              "const html = pm.response.text();",
              "const $ = require('cheerio').load(html);",
              "const csrf = $('form').filter((i, form) => /\\/logout\\/?$/.test($(form).attr('action') || ''))",
              "    .find('input[name=\"_token\"]').first().attr('value') || $('meta[name=\"csrf-token\"]').attr('content');",
              "pm.environment.unset('csrf_token');",
              "pm.test('Token CSRF sesi login aktif tersedia untuk logout', () => {",
              "    pm.expect(csrf, 'Token sesi aktif tidak ditemukan pada form logout/meta csrf-token Dashboard. Jangan gunakan token sebelum login.').to.be.a('string').and.not.empty;",
              "    pm.environment.set('csrf_token', csrf);",
              "});",
              "const cards = $('main article').filter((i, card) =>",
              "    $(card).find('span').toArray().some(label => $(label).text().trim() === 'Total saldo kas'));",
              "const saldo = cards.find('p').first().text().trim();",
              "function rupiahCents(value) {",
              "    const normalized = value.replace(/\\u2212/g, '-').replace(/[\\s\\u00a0\\u202f]+/g, '');",
              "    const match = normalized.match(/^(-)?Rp(-)?((?:\\d{1,3}(?:\\.\\d{3})+|\\d+)),(\\d{2})$/);",
              "    if (!match || (match[1] && match[2])) throw new Error('Format Total saldo kas bukan rupiah Indonesia yang valid.');",
              "    return (match[1] || match[2] ? -1n : 1n) * BigInt(match[3].replace(/\\./g, '') + match[4]);",
              "}",
              "function apiCents(value) {",
              "    if (typeof value !== 'string' || !/^-?\\d+\\.\\d{2}$/.test(value)) {",
              "        throw new Error('Saldo API belum tersedia/invalid. Jalankan Test 07 sebelum Test 08.');",
              "    }",
              "    return BigInt(value.replace('.', ''));",
              "}",
              "pm.test('Saldo dashboard sama dengan API hingga satuan sen', () => {",
              "    pm.expect(cards.length, 'Kartu Total saldo kas harus ditemukan tepat satu.').to.eql(1);",
              "    pm.expect(rupiahCents(saldo) === apiCents(pm.environment.get('api_saldo_akhir'))).to.eql(true);",
              "});"
            ]
          }
        }
      ]
    },
