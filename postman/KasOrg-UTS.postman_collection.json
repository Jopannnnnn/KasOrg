{
  "info": {
    "name": "KasOrg — API JSON UTS",
    "description": "API session Laravel, read-only untuk demo Admin. Isi email/password HANYA pada environment lokal. Jalankan 01–13 berurutan; base_url tanpa slash terakhir. CSRF dan saldo pembanding disimpan pada environment aktif. Dashboard dan API menggunakan periode_id sama. Tidak membuat/mengubah data domain.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "auth": {
    "type": "noauth"
  },
  "event": [
    {
      "listen": "prerequest",
      "script": {
        "type": "text/javascript",
        "exec": [
          "// Environment aktif adalah satu-satunya sumber nilai; singkirkan sisa local scope collection lama.",
          "['base_url', 'email', 'password', 'periode_id', 'csrf_token', 'api_saldo_akhir'].forEach(key => {",
          "    pm.variables.unset(key);",
          "    if (pm.variables.get(key) !== pm.environment.get(key)) {",
          "        throw new Error('Konflik scope variabel ' + key + '. Gunakan environment aktif, bukan iteration data/variabel lokal.');",
          "    }",
          "});",
          "const baseUrl = pm.environment.get('base_url');",
          "if (typeof baseUrl !== 'string' || !/^https?:\\/\\/[^?#\\s]+[^/]$/.test(baseUrl)) {",
          "    throw new Error('Pilih environment lokal dan isi base_url HTTP(S) tanpa slash terakhir, query, atau fragment.');",
          "}"
        ]
      }
    },
    {
      "listen": "test",
      "script": {
        "type": "text/javascript",
        "exec": [
          "if (pm.request.url.toString().includes('/api/')) {",
          "    pm.test('Respons API selalu JSON', () => pm.expect(pm.response.headers.get('Content-Type')).to.include('application/json'));",
          "    const body = pm.response.json();",
          "    pm.test('Envelope API konsisten', () => pm.expect(Object.keys(body).sort()).to.eql(['data','errors','message','success']));",
          "    pm.test('Data API tidak memuat field privat', () => {",
          "        function inspect(value) {",
          "            if (Array.isArray(value)) return value.forEach(inspect);",
          "            if (value && typeof value === 'object') Object.keys(value).forEach(key => {",
          "                pm.expect(['password','password_hash','nim','email','bukti_path','remember_token','diajukan_oleh','diverifikasi_oleh']).not.to.include(key);",
          "                inspect(value[key]);",
          "            });",
          "        }",
          "        inspect(body.data);",
          "    });",
          "}"
        ]
      }
    }
  ],
  "item": [
    {
      "name": "01 Tanpa login — kategori 401",
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Accept",
            "value": "application/json"
          }
        ],
        "url": "{{base_url}}/api/kategori-transaksi"
      },
      "protocolProfileBehavior": {
        "followRedirects": false,
        "disableCookies": true,
        "disableCookieJar": true
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('HTTP 401', () => pm.response.to.have.status(401));",
              "pm.test('Ditolak aman', () => pm.expect(pm.response.json().success).to.eql(false));"
            ]
          }
        }
      ]
    },
    {
      "name": "02 Tanpa login — ringkasan 401",
