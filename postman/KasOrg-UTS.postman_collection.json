          "script": {
            "type": "text/javascript",
            "exec": [
              "if (!pm.environment.get('csrf_token')) {",
              "    throw new Error('Token CSRF sesi aktif belum tersedia. Jalankan Test 08 setelah login sebelum Test 12.');",
              "}"
            ]
          }
        },
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Logout HTTP 302 ke halaman login', () => {",
              "    pm.response.to.have.status(302);",
              "    pm.expect(pm.response.headers.get('Location')).to.eql(pm.environment.get('base_url') + '/login');",
              "});",
              "pm.environment.unset('csrf_token');"
            ]
          }
        }
      ]
    },
    {
      "name": "13 Setelah logout — 401",
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Accept",
            "value": "application/json"
          }
        ],
        "url": "{{base_url}}/api/kategori-transaksi"
      },
      "protocolProfileBehavior": {
